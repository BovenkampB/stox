# Kopieer dit bestand naar .env en vul je eigen sleutel in.
# Een Anthropic API-sleutel haal je op via https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optioneel: welk Claude-model gebruikt wordt voor de redenatie.
# claude-sonnet-5 = goede balans tussen kwaliteit en kosten (aanbevolen om te starten).
# claude-opus-5   = beste kwaliteit, hogere kosten.
STOX_MODEL=claude-sonnet-5

# --- E-mailmeldingen (voor 'stox dip --email') ---
# Voor Gmail: maak een APP-WACHTWOORD aan (niet je gewone wachtwoord):
#   1. Zet 2-staps-verificatie aan op je Google-account.
#   2. Ga naar https://myaccount.google.com/apppasswords en maak er een aan.
#   3. Plak dat 16-tekens-wachtwoord hieronder bij STOX_SMTP_PASSWORD.
STOX_SMTP_HOST=smtp.gmail.com
STOX_SMTP_PORT=587
STOX_SMTP_USER=jouw.adres@gmail.com
STOX_SMTP_PASSWORD=abcd efgh ijkl mnop
# Naar welk(e) adres(sen) de meldingen gaan (standaard: hetzelfde als STOX_SMTP_USER).
# Meerdere ontvangers? Scheid ze met een komma:
STOX_ALERT_TO=jouw.adres@gmail.com, iemand.anders@gmail.com
